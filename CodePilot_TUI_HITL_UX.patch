+    @staticmethod
+    def is_git_push_command(arguments: Sequence[str]) -> bool:
+        """Recognize Git push subcommands, including commands with global options."""
+        if not arguments or Path(arguments[0].replace("\\", "/")).name.lower() not in {
+            "git",
+            "git.exe",
+        }:
+            return False
+
+        options_with_value = {
+            "-C",
+            "-c",
+            "--git-dir",
+            "--work-tree",
+            "--namespace",
+            "--config-env",
+        }
+        index = 1
+        while index < len(arguments):
+            argument = arguments[index]
+            if argument == "--":
+                return False
+            if argument in options_with_value:
+                index += 2
+                continue
+            if argument.startswith(("-C", "-c")) and len(argument) > 2:
+                index += 1
+                continue
+            if argument.startswith(
+                ("--git-dir=", "--work-tree=", "--namespace=", "--config-env=")
+            ):
+                index += 1
+                continue
+            if argument.startswith("-"):
+                index += 1
+                continue
+            return argument.lower() == "push"
+        return False
+
     def check_path(
         self,
         path: str | Path,
