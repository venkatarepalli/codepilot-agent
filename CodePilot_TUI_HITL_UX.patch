+    record = logging.LogRecord(
+        name="codepilot.agents.deepagents_coder_adapter",
+        level=logging.INFO,
+        pathname=__file__,
+        lineno=1,
+        msg="Requesting code changes from the configured LLM.",
+        args=(),
+        exc_info=None,
+    )
+
