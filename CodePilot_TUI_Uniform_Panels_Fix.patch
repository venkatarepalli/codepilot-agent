+        # A Textual grid has to allocate whole terminal rows. If the dashboard
+        # has an odd number of rows, one track receives the remainder. Reserve
+        # one row when needed so the two panel rows remain exactly equal.
+        self.call_after_refresh(self._balance_dashboard_rows)
+
+    def on_resize(self, event: Resize) -> None:
+        """Keep the dashboard's two rows equal when the terminal is resized."""
+        if self._dashboard_container is not None:
+            self.call_after_refresh(self._balance_dashboard_rows)
+
+    def _balance_dashboard_rows(self) -> None:
+        """Reserve a bottom margin when the grid's available height is odd."""
+        dashboard = self._dashboard_container
+        if dashboard is None:
+            return
+        margin = dashboard.styles.margin
+        unreserved_height = dashboard.size.height + margin.bottom
+        desired_bottom_margin = unreserved_height % 2
+        if margin.bottom != desired_bottom_margin:
+            dashboard.styles.margin = (
+                margin.top,
+                margin.right,
+                desired_bottom_margin,
+                margin.left,
+            )
 
     def update_issues(self, issues: Sequence[Mapping[str, Any]]) -> None:
