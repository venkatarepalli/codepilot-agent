# CodePilot configuration
# Copy this file to .env and fill in your values:   Copy-Item .env.example .env
# .env is git-ignored. Never commit real keys or tokens.

# ---------------------------------------------------------------- LLM (required)
# Supported providers: openai | google
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# Set the key that matches LLM_PROVIDER (the other may stay empty).
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------- GitHub (required)
# Fine-grained personal access token scoped to ONE disposable test repository, with:
#   Contents: Read and write | Pull requests: Read and write | Issues: Read and write | Metadata: Read
GITHUB_TOKEN=
GITHUB_REPOSITORY_OWNER=your-github-username
GITHUB_REPOSITORY_NAME=codepilot-smoke-test
# Base branch for pull requests. PRs to main/master always require human approval.
GITHUB_DEFAULT_BRANCH=main

# ---------------------------------------------------------------- Behaviour (optional)
# How often to poll GitHub for issues, in minutes.
CODEPILOT_POLL_INTERVAL_MINUTES=5
# 1-10. Issues WITHOUT the ai-assignable label must be unassigned and score below this.
CODEPILOT_COMPLEXITY_THRESHOLD=7
# Repo Map size limit and number of relevant files returned by retrieval.
CODEPILOT_REPO_MAP_TOKEN_BUDGET=4000
CODEPILOT_REPO_MAP_TOP_K=10
# Where episodic session summaries are stored (default: .codepilot/memory).
# CODEPILOT_MEMORY_DIR=.codepilot/memory
