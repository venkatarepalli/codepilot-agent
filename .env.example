# CodePilot environment configuration
# Copy this file to .env for local development.
# NEVER commit .env or real credentials.

# LLM provider configuration
# Supported providers: google, openai
LLM_PROVIDER=google

# Google Gemini configuration
LLM_MODEL=gemma-4-31b-it
GOOGLE_API_KEY=

# OpenAI configuration
# To use OpenAI, set LLM_PROVIDER=openai and choose your model.
# Example: LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Reserved for future provider support
ANTHROPIC_API_KEY=

# GitHub
GITHUB_TOKEN=
GITHUB_REPOSITORY_OWNER=
GITHUB_REPOSITORY_NAME=
GITHUB_DEFAULT_BRANCH=

# CodePilot runtime
CODEPILOT_POLL_INTERVAL_MINUTES=5
CODEPILOT_COMPLEXITY_THRESHOLD=7
CODEPILOT_REPO_MAP_TOKEN_BUDGET=4000
CODEPILOT_REPO_MAP_TOP_K=10
CODEPILOT_MAX_TEST_RETRIES=3

# Storage
CODEPILOT_STATE_DIR=.codepilot
CODEPILOT_CHROMA_DIR=.codepilot/chroma
